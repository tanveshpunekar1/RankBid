# Database (PostgreSQL - Neon, Supabase, Railway, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rankbid?schema=public"

# Razorpay (India-first payment gateway)
# Get your Test Keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# SMS OTP Provider Config
# Supported: "mock" (logs OTP to terminal & UI for fast testing), "msg91", "twilio"
SMS_PROVIDER="mock"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Admin Dashboard
ADMIN_PIN="8888" # Simple secure PIN or password for /admin
ADMIN_SECRET_TOKEN="rankbid_super_secret_admin_session_key_2026"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
