# Database URL (SQLite for instant zero-dependency local dev, or PostgreSQL for Neon/Supabase/Production)
DATABASE_URL="file:./dev.db"

# Razorpay (India-first payment gateway)
# Leave as test / mock keys for local development
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# SMS OTP Provider Config
# Supported: "mock" (logs OTP to terminal & UI for fast testing), "msg91", "twilio"
SMS_PROVIDER="mock"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Admin Dashboard
ADMIN_PIN="8888"
ADMIN_SECRET_TOKEN="rankbid_super_secret_admin_session_key_2026"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
