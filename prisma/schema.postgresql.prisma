datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Listing {
  id              String       @id @default(cuid())
  url_or_handle   String
  normalized_key  String       @unique
  title           String
  description     String?      @db.Text
  category_slug   String
  submitter_phone String
  is_active       Boolean      @default(true)
  flagged_reason  String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  category        Category?    @relation(fields: [category_slug], references: [slug])
  bids            Bid[]
  clicks          ClickEvent[]

  @@index([normalized_key])
  @@index([category_slug])
  @@index([is_active])
}

model Bid {
  id                  String    @id @default(cuid())
  listing_id          String
  amount_paise        Int
  is_current          Boolean   @default(false)
  razorpay_order_id   String?
  razorpay_payment_id String?
  razorpay_signature  String?
  status              String    @default("PENDING")
  created_at          DateTime  @default(now())

  listing             Listing   @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@index([is_current, amount_paise(sort: Desc)])
  @@index([listing_id, status])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  icon        String    @default("Tag")
  description String?
  listings    Listing[]

  @@index([slug])
}

model ClickEvent {
  id         String   @id @default(cuid())
  listing_id String
  referrer   String?
  user_agent String?
  ip_hash    String?
  created_at DateTime @default(now())

  listing    Listing  @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@index([listing_id, created_at])
}

model PageView {
  id         String   @id @default(cuid())
  path       String
  user_agent String?
  created_at DateTime @default(now())

  @@index([created_at])
}

model OtpSession {
  id         String   @id @default(cuid())
  phone      String
  otp_code   String
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([phone])
}

model AdminUser {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
}
